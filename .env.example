# Server
LISTEN_ADDR=:8090
API_KEY=your-api-key

# Health Dashboard (internal Docker network)
HEALTH_BASE_URL=http://health-receiver:8080
HEALTH_API_KEY=your-health-api-key
HEALTH_CACHE_TTL=300

# Todoist
TODOIST_TOKEN=your-todoist-token
TODOIST_CACHE_TTL=60

# RSS-Summariser (News)
NEWS_BASE_URL=https://news.example.com
NEWS_LIMIT=5
NEWS_SINCE_HOURS=24
NEWS_CACHE_TTL=900

# Home Assistant
HA_BASE_URL=https://ha.example.com
HA_TOKEN=your-long-lived-token
HA_SENSORS=sensor.co2,sensor.temperature,sensor.humidity
HA_LIGHTS=light.living_room,light.bedroom,light.kitchen
HA_CLIMATES=climate.living_room
HA_CACHE_TTL=120

# Calendar Platform (optional; when all three values are set, this replaces
# Home Assistant as the source for GET /api/calendar). Keep the token secret.
CALENDAR_PLATFORM_BASE_URL=https://calendar.example.com
CALENDAR_PLATFORM_TOKEN=your-read-only-token
CALENDAR_PLATFORM_IDS=google:personal,apple:family
CALENDAR_TIME_ZONE=Europe/Belgrade

# Global fetch timeout per source (seconds)
FETCH_TIMEOUT=15

# Synthetic photo-frame fixture; disabled unless explicitly enabled.
PHOTO_FRAME_ENABLED=false
PHOTO_FRAME_SOURCE=none
PHOTO_FRAME_IDLE_SECONDS=300
PHOTO_FRAME_INTERVAL_SECONDS=60
PHOTO_FRAME_MAX_STALE_SECONDS=900
PHOTO_FRAME_CACHE_FRAMES=32

# Optional Immich album source (PHOTO_FRAME_SOURCE=immich).
# Mount the API key as a read-only private regular file; never put it here.
IMMICH_BASE_URL=https://photos.example.com
IMMICH_ALBUM_ID=
IMMICH_API_KEY_FILE=/run/secrets/immich-api-key
